-{t:"\u0db4\u0dd2\u0dba\u0dc0\u0dbb 3 - \u0db4\u0dcf\u0dbd\u0db1 \u0db6\u0ddc\u0dad\u0dca\u0dad\u0db8\u0dca",b:"\u0d95\u0db1\u0dd0\u0db8 \u0dc0\u0dda\u0dbd\u0dcf\u0dc0\u0d9a \u201c\u0dc0\u0da0\u0db1\u0dba \u0db1\u0dd0\u0dc0\u0dad \u0d85\u0dc3\u0db1\u0dca\u0db1\u201d, \u201c\u0dc3\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0d85\u0dc3\u0db1\u0dca\u0db1\u201d, \u201c\u0d85\u0d9a\u0dd4\u0dbb\u0dd4 \u0d85\u0dc3\u0db1\u0dca\u0db1\u201d \u0dc4\u0ddd \u201c\u0db1\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0db1\u201d \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1."},
-{t:"\u0db4\u0dd2\u0dba\u0dc0\u0dbb 4 - \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 \u0db6\u0dd0\u0dbd\u0dd3\u0db8 \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0",b:"\u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dba\u0dda\u0daf\u0dd3 \u0d94\u0db6 \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2\u0dc0 \u0dbd\u0dd2\u0dba\u0dd6 \u0dc0\u0da0\u0db1 \u0da7\u0dd2\u0d9a\u0dca \u0d9a\u0dbb \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 30\u0db1\u0dca \u0db6\u0dbd\u0db1\u0dca\u0db1, \u0dc0\u0dd0\u0dbb\u0daf\u0dd4\u0dab\u0dd4 \u0dc0\u0da0\u0db1 \u0db1\u0dd0\u0dc0\u0dad \u0db4\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0dc3\u0dc4 \u201c\u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0\u201d \u0db4\u0da7\u0dd2\u0dad\u0dca\u0dad\u0dd9\u0db1\u0dca \u0d94\u0db6\u0dda \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db6\u0dd9\u0daf\u0dcf\u0d9c\u0db1\u0dca\u0db1!"}
